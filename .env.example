# Supabase — găsești în Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role — DOAR pe server, nu expune clientului
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Numărul de WhatsApp fără + (ex: România: 40712345678)
NEXT_PUBLIC_WHATSAPP_NUMBER=40712345678

# Numărul de telefon afișat pe site
NEXT_PUBLIC_PHONE=0712345678

# URL-ul site-ului (pentru metadata OpenGraph)
NEXT_PUBLIC_SITE_URL=https://shaormeria-ta.ro
